PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (Meta) - required to actually send notifications.
# Create a WhatsApp Business Platform app at developers.facebook.com to get these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The shop's WhatsApp number that should receive booking notifications
# (international format, digits only, no + or spaces).
SHOP_WHATSAPP_NUMBER=233247083940

# Name of an approved message template for business-initiated notifications.
# Leave blank only while testing against a number with an open 24h session;
# a real launch needs an approved template here.
WHATSAPP_TEMPLATE_NAME=
